# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster...)
MONGODB_URI=

# Random secret used to sign admin JWTs (pick a long random string)
JWT_SECRET=

# Admin dashboard credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# SMTP for contact-form notifications (optional; messages still save to MongoDB)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where contact notifications are sent (defaults to SMTP_USER)
CONTACT_EMAIL=

# Public site URL (used in email templates / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000